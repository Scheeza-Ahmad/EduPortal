// EduPortal — Prisma Schema
// Postgres via Supabase. Soft deletes everywhere (isActive), never hard delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  super_admin
  school_admin
  teacher
  student
  parent
  finance
  coordinator
}

enum ActivityType {
  assignment
  quiz
  project
  presentation
}

enum AttendanceStatus {
  present
  absent
  late
  leave
  half_day
}

enum BadgeType {
  perfect_week
  top_of_class
  streak_7
  streak_30
  full_marks
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum Wing {
  junior // Class 1-5
  senior // Class 6-10
  both // teachers only — can teach/class-teach either wing
}

enum FeeStatus {
  unpaid
  partial
  paid
  overdue
}

// ---------------------------------------------------------------
// Core: Users & Auth
// ---------------------------------------------------------------

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String // bcrypt hash, never returned in API responses
  role        Role
  schoolId    String? // null for super_admin
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  teacherProfile TeacherProfile?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  auditLogs     AuditLog[]
  notifications Notification[]

  teachingSubjects Subject[]      @relation("SubjectTeacher")
  classTeacherOf   Class[]        @relation("ClassTeacher")
  activities       Activity[]     @relation("ActivityCreatedBy")
  submissions      Submission[]   @relation("SubmissionStudent")
  attendanceMarks  Attendance[]   @relation("AttendanceStudent")
  announcements    Announcement[] @relation("AnnouncementAuthor")
  leaveRequests    LeaveRequest[] @relation("LeaveRequester")
  teacherLeaves    TeacherLeave[] @relation("TeacherLeaveRequester")

  studentFees  StudentFee[] @relation("StudentFees")
  recordedFees FeePayment[] @relation("FeePayments")

  teacherReports     MonthlyReport[] @relation("TeacherReports")
  coordinatorReviews MonthlyReport[] @relation("CoordinatorReviews")
  wingReports        WingReport[]    @relation("CoordinatorWingReports")

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the raw refresh token
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  otpHash   String // bcrypt hash of the 6-digit OTP
  expiresAt DateTime // 10 minutes from creation
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------
// School structure
// ---------------------------------------------------------------

model School {
  id       String  @id @default(cuid())
  name     String
  city     String
  phone    String?
  adminId  String?
  isActive Boolean @default(true)

  // feature flags (per CLAUDE.md: parentPortal, aiFeatures, smsNotify, urdu)
  featureParentPortal Boolean @default(true)
  featureAi           Boolean @default(false)
  featureSms          Boolean @default(false)
  featureUrdu         Boolean @default(false)

  // feature flags — added for the full feature-management system
  featureCoordinator    Boolean @default(true)
  featureLeaveRequests  Boolean @default(true)
  featureConsentForms   Boolean @default(true)
  featureFinance        Boolean @default(true)
  featureAiInsights     Boolean @default(false)
  featureAttendance     Boolean @default(true)
  featureTimetable      Boolean @default(true)
  featureAnnouncements  Boolean @default(true)
  featureCalendar       Boolean @default(true)
  featureReportCards    Boolean @default(true)
  featureBadges         Boolean @default(true)
  featureMonthlyReports Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  classes       Class[]
  timetable     TimetableSlot[]
  academicDates AcademicDate[]
  announcements Announcement[]

  settings         SchoolSettings?
  discountPolicies DiscountPolicy[]
  lateFeeRule      LateFeeRule?
  feeStructures    FeeStructure[]
  financeReports   FinanceReport[]

  monthlyReports MonthlyReport[]
  wingReports    WingReport[]
  consentForms   ConsentForm[]

  @@index([adminId])
}

model Class {
  id             String  @id @default(cuid())
  schoolId       String
  number         Int // 1-10 (the class/grade number)
  section        String // "A" | "B" | "C"
  wing           Wing // auto-assigned from number: 1-5 -> junior, 6-10 -> senior
  classTeacherId String? // one class teacher per section
  maxStudents    Int     @default(30)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  classTeacher    User?            @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  subjects        Subject[]
  studentProfiles StudentProfile[]
  timetableSlots  TimetableSlot[]
  announcements   Announcement[]

  @@unique([schoolId, number, section])
  @@index([schoolId])
  @@index([wing])
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  classId     String
  teacherId   String
  creditHours Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation("SubjectTeacher", fields: [teacherId], references: [id])

  activities     Activity[]
  attendance     Attendance[]
  timetableSlots TimetableSlot[]

  @@index([classId])
  @@index([teacherId])
}

// ---------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------

model StudentProfile {
  id       String    @id @default(cuid())
  userId   String    @unique
  classId  String
  rollNo   String
  parentId String?
  dob      DateTime?
  phone    String?
  address  String?
  photoUrl String? // Cloudinary URL
  bio      String?

  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id])
  class  Class          @relation(fields: [classId], references: [id])
  parent ParentProfile? @relation(fields: [parentId], references: [id])

  submissions Submission[]
  grades      Grade[]      @relation("GradeStudent")
  badges      Badge[]

  @@index([classId])
  @@index([parentId])
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  children StudentProfile[]
}

model TeacherProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  wing            Wing // junior | senior | both
  isClassTeacher  Boolean @default(false)
  isCoordinator   Boolean @default(false)
  coordinatorWing Wing?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------
// Timetable & Calendar
// ---------------------------------------------------------------

model TimetableSlot {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "09:45"
  room      String?

  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

model AcademicDate {
  id       String   @id @default(cuid())
  schoolId String
  title    String
  type     String // exam | holiday | event
  date     DateTime

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ---------------------------------------------------------------
// Activities, Submissions, Grades
// ---------------------------------------------------------------

model Activity {
  id          String       @id @default(cuid())
  subjectId   String
  createdById String
  type        ActivityType
  title       String
  description String?
  dueDate     DateTime
  totalMarks  Int
  fileUrl     String? // Cloudinary URL
  isDraft     Boolean      @default(false)
  isLocked    Boolean      @default(false) // set true once dueDate passes (dueDateLock job)
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())

  subject     Subject      @relation(fields: [subjectId], references: [id])
  createdBy   User         @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  submissions Submission[]

  @@index([subjectId])
  @@index([dueDate])
}

model Submission {
  id            String   @id @default(cuid())
  activityId    String
  studentId     String // StudentProfile.id
  studentUserId String // User.id (for convenience relation)
  fileUrl       String? // Cloudinary URL
  textContent   String?
  submittedAt   DateTime @default(now())
  isLate        Boolean  @default(false)

  activity       Activity       @relation(fields: [activityId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentId], references: [id])
  studentUser    User           @relation("SubmissionStudent", fields: [studentUserId], references: [id])
  grade          Grade?

  @@unique([activityId, studentId])
  @@index([activityId])
  @@index([studentId])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  studentId    String // StudentProfile.id (denormalized for fast queries)
  marks        Float
  feedback     String?
  gradedAt     DateTime @default(now())

  submission     Submission     @relation(fields: [submissionId], references: [id])
  studentProfile StudentProfile @relation("GradeStudent", fields: [studentId], references: [id])

  @@index([studentId])
}

// ---------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------

model Attendance {
  id        String           @id @default(cuid())
  studentId String // User.id
  subjectId String
  date      DateTime
  status    AttendanceStatus

  createdAt DateTime @default(now())

  student User    @relation("AttendanceStudent", fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, date])
  @@index([studentId])
  @@index([subjectId])
}

// ---------------------------------------------------------------
// Announcements, Leave, Notifications, Badges, Audit
// ---------------------------------------------------------------

model Announcement {
  id       String  @id @default(cuid())
  schoolId String
  authorId String
  classId  String? // null = school-wide
  title    String
  body     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  class  Class? @relation(fields: [classId], references: [id])

  @@index([schoolId])
  @@index([classId])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  requesterId String // User.id (student or teacher)
  reason      String
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(pending)
  type        String      @default("leave") // "leave" | "half_day" — only meaningful for student requests
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?

  createdAt DateTime @default(now())

  requester User @relation("LeaveRequester", fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([status])
}

// Teacher/coordinator leave — separate from LeaveRequest (student/teacher
// generic leave), because the review chain here is hierarchical:
// teacher -> coordinator -> (approved) -> admin sees it; coordinator's own
// leave skips straight to admin.
model TeacherLeave {
  id         String    @id @default(cuid())
  teacherId  String
  schoolId   String
  fromDate   DateTime  @db.Date
  toDate     DateTime  @db.Date
  reason     String
  status     String    @default("pending") // pending | approved | rejected
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  teacher User @relation("TeacherLeaveRequester", fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([schoolId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Badge {
  id        String    @id @default(cuid())
  studentId String // StudentProfile.id
  type      BadgeType
  awardedAt DateTime  @default(now())

  studentProfile StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  targetTable String?
  targetId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// Fee & Finance (multi-tenant — every record carries schoolId)
// ---------------------------------------------------------------

model SchoolSettings {
  id                String   @id @default(cuid())
  schoolId          String   @unique
  sessionStartMonth Int      @default(4) // April
  termsPerYear      Int      @default(2)
  invoicePrefix     String   @default("INV")
  invoiceFooterText String?
  principalName     String?
  address           String?
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Timetable settings
  schoolStartTime String   @default("08:00")
  schoolEndTime   String   @default("14:00")
  periodDuration  Int      @default(45)
  breakStartTime  String   @default("10:30")
  breakDuration   Int      @default(20)
  workingDays     String[] @default(["monday", "tuesday", "wednesday", "thursday", "friday"])

  // White-labeling / branding
  portalName   String?
  logoUrl      String?
  primaryColor String  @default("#1a56db")
  sidebarColor String?
  accentColor  String  @default("#f97316")
  fontFamily   String  @default("Inter")
  loginBgColor String  @default("#ffffff")
  loginMessage String?
  faviconUrl   String?

  school School @relation(fields: [schoolId], references: [id])
}

model DiscountPolicy {
  id                  String   @id @default(cuid())
  schoolId            String
  name                String // "Orphan", "Scholarship", "Kinship"
  discountPercent     Float // 90, 50, 40
  eligibilityCriteria String? // description
  marksThreshold      Float? // for scholarship: 90.0
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id])
  studentFees StudentFee[]

  @@index([schoolId])
}

model LateFeeRule {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  gracePeriodDays Int      @default(5)
  finePerPeriod   Float    @default(1000)
  periodDays      Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
}

model FeeStructure {
  id          String   @id @default(cuid())
  schoolId    String
  classNumber Int
  monthYear   String // "2024-09"
  baseFee     Float
  dueDate     DateTime
  createdAt   DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id])
  studentFees StudentFee[]

  @@unique([schoolId, classNumber, monthYear])
  @@index([schoolId])
}

model StudentFee {
  id               String    @id @default(cuid())
  studentId        String
  feeStructureId   String
  schoolId         String
  discountPolicyId String?
  discountPercent  Float     @default(0)
  baseFee          Float
  discountAmount   Float     @default(0)
  netPayable       Float
  paidAmount       Float     @default(0)
  lateFine         Float     @default(0)
  totalDue         Float
  status           FeeStatus @default(unpaid)
  dueDate          DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student        User            @relation("StudentFees", fields: [studentId], references: [id])
  feeStructure   FeeStructure    @relation(fields: [feeStructureId], references: [id])
  discountPolicy DiscountPolicy? @relation(fields: [discountPolicyId], references: [id])
  payments       FeePayment[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([schoolId])
  @@index([status])
}

model FeePayment {
  id            String   @id @default(cuid())
  studentFeeId  String
  schoolId      String
  amount        Float
  paymentDate   DateTime @default(now())
  receiptNumber String   @unique
  recordedBy    String
  notes         String?
  createdAt     DateTime @default(now())

  studentFee     StudentFee @relation(fields: [studentFeeId], references: [id])
  recordedByUser User       @relation("FeePayments", fields: [recordedBy], references: [id])

  @@index([studentFeeId])
  @@index([schoolId])
}

model FinanceReport {
  id            String    @id @default(cuid())
  schoolId      String
  monthYear     String
  submittedBy   String
  totalDue      Float
  totalPaid     Float
  totalPending  Float
  totalLateFine Float
  status        String    @default("draft")
  notes         String?
  meta          Json? // class-wise + per-student breakdown snapshot, see computeReportDetail()
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, monthYear])
  @@index([schoolId])
}

// ---------------------------------------------------------------
// Coordinator module
// ---------------------------------------------------------------

enum ReportStatus {
  draft
  submitted
  reviewed
  forwarded
  approved
  rejected
}

model MonthlyReport {
  id                        String       @id @default(cuid())
  teacherId                 String
  schoolId                  String
  monthYear                 String // "2026-09"
  activitiesCount           Int          @default(0)
  attendanceRate            Float        @default(0)
  studentPerformanceSummary String?
  challengesFaced           String?
  plansNextMonth            String?
  status                    ReportStatus @default(draft)
  coordinatorComment        String?
  coordinatorReviewedAt     DateTime?
  coordinatorId             String?
  adminComment              String?
  adminApprovedAt           DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  teacher     User   @relation("TeacherReports", fields: [teacherId], references: [id])
  school      School @relation(fields: [schoolId], references: [id])
  coordinator User?  @relation("CoordinatorReviews", fields: [coordinatorId], references: [id])

  @@unique([teacherId, monthYear])
  @@index([schoolId])
  @@index([teacherId])
  @@index([status])
}

// A coordinator's wing-wide monthly summary submitted to the school admin —
// distinct from MonthlyReport (one per teacher). Not in the original spec's
// schema step; added because STEP 7 requires a listable, approvable entity.
model WingReport {
  id            String       @id @default(cuid())
  schoolId      String
  coordinatorId String
  wing          Wing
  monthYear     String
  summary       Json // auto-generated wing stats snapshot
  notes         String? // coordinator's notes/recommendations
  status        ReportStatus @default(submitted)
  adminComment  String?
  submittedAt   DateTime     @default(now())
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  school      School @relation(fields: [schoolId], references: [id])
  coordinator User   @relation("CoordinatorWingReports", fields: [coordinatorId], references: [id])

  @@unique([schoolId, wing, monthYear])
  @@index([schoolId])
  @@index([coordinatorId])
  @@index([status])
}

// ---------------------------------------------------------------
// Consent Forms
// ---------------------------------------------------------------

model ConsentForm {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String
  dueDate     DateTime
  createdBy   String // admin userId
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school    School            @relation(fields: [schoolId], references: [id])
  responses ConsentResponse[]

  @@index([schoolId])
}

model ConsentResponse {
  id            String   @id @default(cuid())
  consentFormId String
  parentId      String
  studentId     String
  approved      Boolean
  notes         String?
  respondedAt   DateTime @default(now())

  consentForm ConsentForm @relation(fields: [consentFormId], references: [id])

  @@unique([consentFormId, studentId])
  @@index([consentFormId])
}
